
# Python environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyd

# Environment variables and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Credentials and private keys
*.pem
*.key
credentials.json
service-account*.json

# Jupyter
.ipynb_checkpoints/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp

# Local data and experiment outputs
data/raw/*
# Ignore processed data by default
data/processed/*

# Track the ETF price data required by the deployed application
!data/processed/*.csv
data/runs/*

# Keep directory placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/runs/.gitkeep